#!/usr/bin/env bash
# claudet — control + setup helper for the tAI daemon.
#   claudet setup     interactive: create channel dir, set token + chat id, guide
#   claudet doctor    checklist of what's ready / missing
#   claudet up|down|restart|status|logs|attach
set -uo pipefail

HOME_DIR="__HOME__"
TAI_HOME="__TAI_HOME__"
TG_DIR="$HOME_DIR/.claude/channels/telegram"
TG_ENV="$TG_DIR/.env"
PLUGIN_DIR="$HOME_DIR/.claude/plugins/cache/claude-plugins-official/telegram"
OS="$(uname -s)"
UID_NUM="$(id -u)"
say(){ printf "\033[1;36m==>\033[0m %s\n" "$*"; }
ok(){ printf "  \033[1;32m✓\033[0m %s\n" "$*"; }
no(){ printf "  \033[1;31m✗\033[0m %s\n" "$*"; }
have(){ command -v "$1" >/dev/null 2>&1; }

envval(){ [ -f "$TG_ENV" ] && grep -E "^$1=" "$TG_ENV" | head -1 | cut -d= -f2- || true; }

svc_up(){
  if [ "$OS" = Darwin ]; then
    launchctl bootstrap "gui/$UID_NUM" "$HOME_DIR/Library/LaunchAgents/com.claudet.plist" 2>/dev/null || true
    launchctl bootstrap "gui/$UID_NUM" "$HOME_DIR/Library/LaunchAgents/com.claudet-watchdog.plist" 2>/dev/null || true
    launchctl kickstart -k "gui/$UID_NUM/com.claudet"
  else
    loginctl enable-linger "$USER" 2>/dev/null || true
    systemctl --user enable --now claudet.service 2>/dev/null || true
    systemctl --user enable --now claudet-watchdog.timer 2>/dev/null || true
    systemctl --user restart claudet
  fi
}
svc_down(){
  if [ "$OS" = Darwin ]; then
    launchctl bootout "gui/$UID_NUM/com.claudet" 2>/dev/null||true
    launchctl bootout "gui/$UID_NUM/com.claudet-watchdog" 2>/dev/null||true
  else systemctl --user stop claudet; fi
}
svc_status(){ if [ "$OS" = Darwin ]; then launchctl print "gui/$UID_NUM/com.claudet" 2>/dev/null | grep -E "state =|pid ="||echo "not loaded"; else systemctl --user status claudet --no-pager; fi; }
svc_logs(){ if [ "$OS" = Darwin ]; then tail -f "$HOME_DIR/Library/Logs/claudet.log"; else journalctl --user -u claudet -f; fi; }

cmd_doctor(){
  say "tAI doctor"
  have claude && ok "claude CLI installed" || no "claude CLI missing"
  if [ -f "$HOME_DIR/.claude/.credentials.json" ] || [ -n "${ANTHROPIC_API_KEY:-}" ]; then ok "claude appears authenticated"; else no "claude NOT logged in — run: claude"; fi
  [ -d "$PLUGIN_DIR" ] && ok "telegram plugin installed" || no "telegram plugin missing — in a claude session: /plugin (install 'telegram' from claude-plugins-official)"
  [ -n "$(envval TELEGRAM_BOT_TOKEN)" ] && ok "TELEGRAM_BOT_TOKEN set" || no "TELEGRAM_BOT_TOKEN not set — run: claudet setup"
  [ -n "$(envval TELEGRAM_CHAT_ID)" ] && ok "TELEGRAM_CHAT_ID set" || no "TELEGRAM_CHAT_ID not set — run: claudet setup"
  if ( cd "$TAI_HOME" && uv run tai-mem doctor >/dev/null 2>&1 ); then ok "tai-memory OK"; else no "tai-memory doctor failed — check Postgres/.env"; fi
  if [ "$OS" = Darwin ]; then launchctl print "gui/$UID_NUM/com.claudet" >/dev/null 2>&1 && ok "service loaded" || no "service not loaded"; else systemctl --user is-active claudet >/dev/null 2>&1 && ok "service active" || no "service not active — claudet up"; fi
}

cmd_setup(){
  say "tAI setup"
  mkdir -p "$TG_DIR"; touch "$TG_ENV"
  if ! have claude; then no "Install Claude Code first: https://claude.com/claude-code"; exit 1; fi
  if [ ! -f "$HOME_DIR/.claude/.credentials.json" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    no "claude is not logged in. Run 'claude' once to log in, then re-run 'claudet setup'."; exit 1; fi
  if [ ! -d "$PLUGIN_DIR" ]; then
    no "telegram plugin not installed. Open 'claude', run /plugin, install 'telegram' from claude-plugins-official, then re-run 'claudet setup'."; exit 1; fi
  printf "Telegram bot token (from @BotFather): "; read -r TOKEN
  printf "Your Telegram chat id (from @userinfobot): "; read -r CHATID
  # write/update the two keys idempotently
  tmp="$(mktemp)"; grep -vE '^(TELEGRAM_BOT_TOKEN|TELEGRAM_CHAT_ID)=' "$TG_ENV" 2>/dev/null > "$tmp" || true
  { echo "TELEGRAM_BOT_TOKEN=$TOKEN"; echo "TELEGRAM_CHAT_ID=$CHATID"; } >> "$tmp"; mv "$tmp" "$TG_ENV"; chmod 600 "$TG_ENV"
  ok "wrote token + chat id to $TG_ENV"
  say "Now, inside a 'claude' session, run:  /telegram:configure   then   /telegram:access  (approve your chat id)."
  say "Then start the daemon:  claudet up"
}

case "${1:-doctor}" in
  setup) cmd_setup ;;
  doctor) cmd_doctor ;;
  up|start) svc_up; say "started — 'claudet status' / 'claudet logs'";;
  down|stop) svc_down; say "stopped";;
  restart) svc_up; say "restarted";;
  status) svc_status ;;
  logs) svc_logs ;;
  attach) tmux -L claudet attach -t claudet ;;
  *) echo "usage: claudet {setup|doctor|up|down|restart|status|logs|attach}";;
esac
