#!/bin/bash
# Send a Telegram message to the owner from daemon infra (hooks, watchdog).
# Usage: claudet-notify "message text"
set -u

ENV_FILE="__HOME__/.claude/channels/telegram/.env"

[[ -f "$ENV_FILE" ]] || exit 0
TOKEN=$(grep -E '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" | head -1 | cut -d= -f2-)
CHAT_ID=$(grep -E '^TELEGRAM_CHAT_ID=' "$ENV_FILE" | head -1 | cut -d= -f2-)
[[ -n "${TOKEN:-}" && -n "${CHAT_ID:-}" ]] || exit 0

MSG="${1:-}"
[[ -n "$MSG" ]] || exit 0

curl -sS --max-time 10 \
    "https://api.telegram.org/bot${TOKEN}/sendMessage" \
    -d "chat_id=${CHAT_ID}" \
    --data-urlencode "text=${MSG}" \
    -o /dev/null || true
