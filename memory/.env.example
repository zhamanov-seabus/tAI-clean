# Postgres connection (Homebrew postgresql@17, default port 5432)
# Role `tai` / db `tai_memory` are created in setup; pgvector + pgcrypto extensions enabled.
POSTGRES_URL=postgresql://tai:tai@localhost:5432/tai_memory

# Local embedding model (no API key needed). Downloaded on first use, cached locally.
# Multilingual: handles English + Russian. Dim must match the vector(N) column in migrations.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
